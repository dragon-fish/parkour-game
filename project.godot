; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Parkour Game"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

WindowMemory="*res://scripts/debug/window_memory.gd"
PauseUi="*res://scripts/ui/pause_ui.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg", "res://addons/vrm/plugin.cfg", "res://addons/Godot-MToon-Shader/plugin.cfg", "res://addons/respawn_gizmos/plugin.cfg", "res://addons/game_window_memory/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/noto_sans_sc.tres"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
; Volumetric fog resolution. Godot ships 64x64x64 froxels spread over the whole
; Environment.volumetric_fog_length, which is far coarser than the 4096 shadow
; map surfaces get -- so a scene shows crisp shadows on its walls and a mushy
; blob of a light shaft in the air, and an occluder thinner than one froxel
; (a roof panel) fails to block sunlit fog above it at all.
; THE OWNER, on the factory hall: "光柱是柔和的圆柱，影子是尖锐的边缘，房顶还能
; 透光看到太阳，有点搞笑". This is the setting that closes that gap. It is
; global and it costs GPU time; halve both numbers to take it back.
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=128

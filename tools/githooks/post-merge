#!/bin/sh
# Tracked hook -- git itself never syncs .git/hooks, so this directory is
# the synced copy and `core.hooksPath` points at it. Install with:
#   bun tools/link_private.ts --install-hooks
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
. "$root/tools/githooks/_lfs.sh"
run_lfs post-merge "$@"

# Keep the .private links in step with whatever just landed: a pull, a
# branch switch, a submodule update. Silent when there is no .private.
#
# Bun, not python: a Windows JUNCTION -- the only link a normal user may
# create there -- is a first-class citizen of node:fs, and `python3` on that
# platform is a Microsoft Store stub that sits on PATH and is not Python.
# A machine without bun keeps whatever links it already had; it says so
# rather than failing the hook, since a checkout must not be held hostage
# to a tool being absent.
if command -v bun >/dev/null 2>&1; then
	bun "$root/tools/link_private.ts" || true
else
	echo "link_private: bun not found -- links not refreshed (see docs/author-notes.md)" >&2
fi
